# ── Vercel Blob ──────────────────────────────────────────────────────────────
# Stores uploaded images and the shared portfolio content (portfolio.json).
# On Vercel: create a Blob store (Storage tab) and link it to the project — this
# variable is then injected automatically. For local dev, link the project and
# run `vercel env pull .env.local`, or paste a token below.
BLOB_READ_WRITE_TOKEN=

# ── Admin ────────────────────────────────────────────────────────────────────
# Password for the /admin area. If unset, falls back to the demo "12345678".
# Set a real one before sharing the site.
ADMIN_PASSWORD=
